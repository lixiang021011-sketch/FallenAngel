# 换行统一成 LF（Windows 上编辑 Unity 资源最容易踩的坑）
* text=auto eol=lf

*.cs    text diff=csharp
*.js    text
*.json  text
*.md    text
*.txt   text
*.unity text
*.asset text
*.meta  text

*.png   binary
*.jpg   binary
*.otf   binary
*.ttf   binary
*.dll   binary
*.so    binary
*.apk   binary
*.exe   binary
*.unitypackage binary

# 可选：美术/字体改用 Git LFS 时，取消下面两行注释（先 git lfs install）
# *.png filter=lfs diff=lfs merge=lfs -text
# *.otf filter=lfs diff=lfs merge=lfs -text
