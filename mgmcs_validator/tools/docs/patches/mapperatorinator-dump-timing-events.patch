+def dump_timing_events(events: list, types_first: bool, output_path: Path) -> Path:
+    """Write the model's own BEAT / MEASURE / TIMING_POINT observations next to the .osu.
+
+    The .osu format can only carry red lines, so every measure that is not a red line is
+    lost in the export: whoever reads the file back has to *assume* "every `meter` beats,
+    counting from a red line, is a measure". That assumption is exactly what a timing
+    observer must not make (irregular measures, gaps, local re-alignment).
+
+    This dump keeps the observations as the model produced them. Enabled by
+    `dump_timing_events=true`; it changes nothing about the generated beatmap.
+    """
+    step = 1 if types_first else -1
+    rows = []
+    for index, event in enumerate(events):
+        if event.type not in BEAT_TYPES:
+            continue
+        other = index + step
+        if not 0 <= other < len(events) or events[other].type != EventType.TIME_SHIFT:
+            continue
+        rows.append({"type": event.type.value, "time": events[other].value / 1000.0})
+    rows.sort(key=lambda row: (row["time"], row["type"]))
+    output_path.mkdir(parents=True, exist_ok=True)
+    path = output_path / "timing_events.json"
+    path.write_text(json.dumps(rows, indent=1), encoding="utf-8")
+    return path
+
